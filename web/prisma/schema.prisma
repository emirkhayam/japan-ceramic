generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String            @id @default(uuid())
  email          String            @unique
  hashedPassword String
  fullName       String
  company        String?
  phone          String?
  role           UserRole          @default(designer)
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  projects       DesignerProject[]
  favorites      Favorite[]

  @@map("users")
}

model Category {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  sortOrder Int        @default(0)
  parentId  String?
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryHierarchy")
  products  Product[]

  @@map("categories")
}

model Product {
  id           String         @id @default(uuid())
  name         String
  slug         String         @unique
  categoryId   String
  description  String?
  price        Float?
  dimensions   String?
  surface      String?
  weight       String?
  collection   String?
  collectionId    String?
  collectionOrder Int         @default(0)
  color        String?
  isActive     Boolean        @default(true)
  isNew        Boolean        @default(false)
  isPopular    Boolean        @default(false)
  isOnSale     Boolean        @default(false)
  createdAt    DateTime       @default(now())
  pdfUrl       String?
  zipUrl       String?
  boxArea        String?
  boxQuantity    String?
  boxWeight      String?
  thickness      String?
  wearResistance String?
  antiSlip       String?
  rectified      String?
  frostResistant String?
  stainResistant String?
  technology     String?
  application    String?
  favorites      Favorite[]
  images       ProductImage[]
  category     Category       @relation(fields: [categoryId], references: [id])
  collectionRef Collection?   @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  projectItems ProjectItem[]

  @@map("products")
}

model Collection {
  id            String    @id @default(uuid())
  name          String
  slug          String    @unique
  description   String?
  coverImageUrl String?
  spaceTag      String?
  styleTag      String?
  isNew         Boolean   @default(false)
  isRecommended Boolean   @default(false)
  status        String    @default("draft")
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  products      Product[]

  @@map("collections")
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  imageUrl  String
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model DesignerProject {
  id          String        @id @default(uuid())
  userId      String
  name        String
  description String?
  status      ProjectStatus @default(draft)
  createdAt   DateTime      @default(now())
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       ProjectItem[]

  @@map("designer_projects")
}

model ProjectItem {
  id        String          @id @default(uuid())
  projectId String
  productId String
  quantity  Int             @default(1)
  note      String?
  product   Product         @relation(fields: [productId], references: [id])
  project   DesignerProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_items")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("favorites")
}

model ContactLead {
  id        String   @id @default(uuid())
  name      String
  phone     String
  email     String?
  message   String?
  source    String   @default("contacts")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("contact_leads")
}

enum UserRole {
  admin
  designer
}

enum ProjectStatus {
  draft
  in_progress
  completed
}
